diff --git a/Tests/MetalUITestingTests/BracketPhaseTiming.swift b/Tests/MetalUITestingTests/BracketPhaseTiming.swift
new file mode 100644
index 00000000..d86171d9
--- /dev/null
+++ b/Tests/MetalUITestingTests/BracketPhaseTiming.swift
@@ -0,0 +1,78 @@
+import Foundation
+import MetalUI
+import MetalUITesting
+import Testing
+
+// C14b phase-timing instrument (docs/probes/retained-subtrees/phase-timing.patch): wall clock as an
+// instrument only. Needs the Frame.swift hunk of that patch applied.
+@Test(arguments: [BracketArm.value, BracketArm.environment, BracketArm.panels]) @MainActor
+func bracketPhaseTiming(arm: BracketArm) throws {
+    let counting = CountingTextSystem(harnessTextSystem())
+    let (window, _) = try bracketWindow(arm: arm, textSystem: { counting })
+    for _ in 0..<3 { window.window.setNeedsRedraw(); window.tick() }
+    let reps = Int(ProcessInfo.processInfo.environment["SB_REPS"] ?? "") ?? 10
+    let steps = 20
+    var per = [Double](repeating: 0, count: 8)
+    var total = 0.0
+    var frames = 0
+    var xs: [Double] = []
+    for rep in 0..<reps {
+        for i in 0..<8 { ivPhase[i] = 0 }
+        let t0 = DispatchTime.now().uptimeNanoseconds
+        let x0 = Float(20) , y0 = Float(400)
+        // alternate the drag direction so the node does not walk off the canvas
+        let sign: Float = rep % 2 == 0 ? 1 : -1
+        let start = rep % 2 == 0 ? Point(x: Pixels(x0), y: Pixels(y0)) : Point(x: Pixels(x0 + 2 * Float(steps)), y: Pixels(y0))
+        window.drag(from: start, to: Point(x: Pixels(start.x.value + sign * 2 * Float(steps)), y: Pixels(y0)), steps: steps)
+        let dt = Double(DispatchTime.now().uptimeNanoseconds - t0) / 1e9
+        total += dt; frames += steps + 2
+        for i in 0..<8 { per[i] += ivPhase[i] }
+        xs.append(dt / Double(steps + 2) * 1000)
+    }
+    xs.sort()
+    let ms = per.map { String(format: "%.3f", $0 / Double(frames) * 1000) }
+    print("SB timing \(arm) per frame ms: build=\(ms[0]) lowering=\(ms[1]) layout=\(ms[2]) prepaint=\(ms[3]) paint=\(ms[4]) sweeps=\(ms[5]) render=\(ms[6]) tick(mean)=\(String(format: "%.3f", total / Double(frames) * 1000)) rep-median=\(String(format: "%.3f", xs[xs.count / 2]))")
+}
+
+import MetalUILayout
+
+/// Slice 1's costs in release (the C14b close-out owes them): the signature pass and the content memo's
+/// `==`, isolated by accumulators, and the net effect of each memo by switching it off.
+@Test(arguments: [(true, true), (true, false), (false, true), (false, false)]) @MainActor
+func bracketSlice1Costs(layoutMemo: Bool, contentMemo: Bool) throws {
+    let counting = CountingTextSystem(harnessTextSystem())
+    let (window, _) = try bracketWindow(arm: .value, textSystem: { counting })
+    window.window.testingLayoutMemo.isEnabled = layoutMemo
+    window.window.testingContentMemos.isEnabled = contentMemo
+    for _ in 0..<3 { window.window.setNeedsRedraw(); window.tick() }
+    let reps = Int(ProcessInfo.processInfo.environment["SB_REPS"] ?? "") ?? 10
+    let steps = 20
+    var per = [Double](repeating: 0, count: 8)
+    var frames = 0
+    sbSignatureSeconds = 0
+    for rep in 0..<reps {
+        for i in 0..<8 { ivPhase[i] = 0 }
+        let sign: Float = rep % 2 == 0 ? 1 : -1
+        let startX: Float = rep % 2 == 0 ? 20 : 20 + 2 * Float(steps)
+        window.drag(from: Point(x: Pixels(startX), y: Pixels(400)),
+                    to: Point(x: Pixels(startX + sign * 2 * Float(steps)), y: Pixels(400)), steps: steps)
+        frames += steps + 2
+        for i in 0..<8 { per[i] += ivPhase[i] }
+    }
+    let ms = per.map { String(format: "%.3f", $0 / Double(frames) * 1000) }
+    print("SB slice1 layoutMemo=\(layoutMemo) contentMemo=\(contentMemo) per frame ms: build=\(ms[0]) layout=\(ms[2]) render=\(ms[6]) signaturePass=\(String(format: "%.3f", sbSignatureSeconds / Double(frames) * 1000)) contentEq=\(ms[7])")
+}
+
+
+/// Element-level work per drag frame (the "before" literals for lane 1's conservation pins).
+@Test(arguments: [BracketArm.value, BracketArm.environment, BracketArm.panels]) @MainActor
+func bracketElementWork(arm: BracketArm) throws {
+    let counting = CountingTextSystem(harnessTextSystem())
+    let (window, _) = try bracketWindow(arm: arm, textSystem: { counting })
+    for _ in 0..<3 { window.window.setNeedsRedraw(); window.tick() }
+    window.resetFrameWork()
+    for i in 0..<3 { sbCounts[i] = 0 }
+    window.drag(from: Point(x: Pixels(20), y: Pixels(400)), to: Point(x: Pixels(60), y: Pixels(400)), steps: 20)
+    let n = Double(window.frameWork.count)
+    print("SB elements \(arm) per frame over \(window.frameWork.count) frames: requestLayout=\(Double(sbCounts[0]) / n) prepaint=\(Double(sbCounts[1]) / n) paint=\(Double(sbCounts[2]) / n)")
+}
