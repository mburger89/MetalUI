@@ -0,0 +1,80 @@
+// TE-R item 2's height census (docs/probes/text-semantics-height-census.patch).
+// Logs every Text/ProposalText leaf whose finite height placement proposal is
+// below its natural height at that proposal's width, over every tree and size
+// the fourteen offscreen images use, the 920x560 demo window, and the controls
+// demo. Skips without METALUI_TEXT_CENSUS=1. Never committed to Tests/.
+
+import Testing
+import Foundation
+import Metal
+import MetalUICore
+import MetalUILayout
+import MetalUITextSystem
+@testable import MetalUI
+@testable import MetalUIDemoContent
+
+@MainActor
+private func census(_ name: String, side: Int, height: Int? = nil, frames: Int,
+                    appearance: Appearance = .light,
+                    content: @escaping @MainActor () -> some Element) throws -> Int {
+    let device = try #require(MTLCreateSystemDefaultDevice(), "no Metal device")
+    censusTextLeaves = [:]
+    var rows = Set<String>()
+    var leavesPlaced = 0
+    censusLeafPlacementHook = { id, proposal, bounds in
+        MainActor.assumeIsolated {
+            guard let leaf = censusTextLeaves[id] else { return }
+            leavesPlaced += 1
+            guard let h = proposal.height, h.isFinite else { return }
+            let width = proposal.width.map { max($0, 0.5) }
+            let natural = leaf.system.measure(leaf.string, font: leaf.font, wrappingAt: width).totalHeight
+            if h < natural {
+                let s = leaf.string.prefix(40).replacingOccurrences(of: "\n", with: "\\n")
+                rows.insert("CENSUS-ROW \(name) \(leaf.kind) \"\(s)\" proposal=(\(proposal.width.map { "\($0)" } ?? "nil"), \(h)) natural=\(natural) placed=\(bounds.width)x\(bounds.height)")
+            }
+        }
+    }
+    defer { censusLeafPlacementHook = nil }
+    let (window, platform) = try makeFakeWindow(device: device, size: side, appearance: appearance,
+                                                content: content)
+    if let height {
+        platform.simulateResize(to: Size(width: Pixels(Float(side)), height: Pixels(Float(height))))
+    }
+    for _ in 0..<frames {
+        window.setNeedsRedraw()
+        window.drawFrameIfNeeded()
+    }
+    for row in rows.sorted() { print(row) }
+    print("CENSUS \(name) \(side)x\(height ?? side) textLeafPlacements=\(leavesPlaced) rows=\(rows.count)")
+    return rows.count
+}
+
+@Test @MainActor func zzTextHeightCensus() throws {
+    guard ProcessInfo.processInfo.environment["METALUI_TEXT_CENSUS"] == "1" else { return }
+    demoModel.showModal = false
+    demoModel.animationDemoActive = false
+    var total = 0
+    for (suffix, appearance) in [("light", Appearance.light), ("dark", Appearance.dark)] {
+        total += try census("default-\(suffix)-f0", side: 1024, frames: 1, appearance: appearance) { demoContent() }
+        total += try census("default-\(suffix)-f3", side: 1024, frames: 4, appearance: appearance) { demoContent() }
+    }
+    demoModel.showModal = true
+    total += try census("modal-1024", side: 1024, frames: 1) { demoContent() }
+    total += try census("prod-modal-920x560", side: 920, height: 560, frames: 1) { demoContent() }
+    demoModel.showModal = false
+    demoModel.animationDemoActive = true
+    total += try census("animation-1024", side: 1024, frames: 1) { demoContent() }
+    total += try census("animation-920x560", side: 920, height: 560, frames: 1) { demoContent() }
+    demoModel.animationDemoActive = false
+    total += try census("prod-default-920x560", side: 920, height: 560, frames: 1) { demoContent() }
+    total += try census("preview-1024", side: 1024, frames: 1) { nativeLayoutPreviewContent() }
+    total += try census("preview-920x560", side: 920, height: 560, frames: 1) { nativeLayoutPreviewContent() }
+    total += try census("controls-920x560", side: 920, height: 560, frames: 2) { controlsDemoContent() }
+    total += try census("controls-1024", side: 1024, frames: 2) { controlsDemoContent() }
+    total += try census("chrome-560", side: 560, frames: 1) {
+        DifferentialRoot(width: 560, height: 560) {
+            Column { CounterPanel() }.width(Pixels(560))
+        }
+    }
+    print("CENSUS TOTAL rows=\(total)")
+}
