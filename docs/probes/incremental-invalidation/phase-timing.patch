+// ---- phase-timing instrument (docs/probes/incremental-invalidation/phase-timing.patch) ----
+import Foundation
+@Test(arguments: [2, 3, 4]) @MainActor func ivPhaseTiming(levels: Int) throws {
+    let counting = CountingTextSystem(harnessTextSystem())
+    let (window, cells) = try ivWindow(levels: levels, counting: counting)
+    for i in 0..<20 { cells[0].value += 1 + i; window.tick() }
+    for i in 0..<8 { ivPhase[i] = 0 }
+    let frames = Int(ProcessInfo.processInfo.environment["IV_FRAMES"] ?? "") ?? 200
+    let t0 = DispatchTime.now().uptimeNanoseconds
+    for i in 0..<frames { cells[cells.count - 1].value += 1 + i; window.tick() }
+    let total = Double(DispatchTime.now().uptimeNanoseconds - t0) / 1e9
+    let ms = ivPhase.map { String(format: "%.3f", $0 / Double(frames) * 1000) }
+    print("IV timing L=\(levels) nodes≈\(cells.count * 2 + (cells.count - 1) / 2) per frame ms: build=\(ms[0]) lowering=\(ms[1]) layout=\(ms[2]) prepaint=\(ms[3]) paint=\(ms[4]) sweeps=\(ms[5]) render=\(ms[6]) getters=\(ms[7]) tick=\(String(format: "%.3f", total / Double(frames) * 1000))")
+}
