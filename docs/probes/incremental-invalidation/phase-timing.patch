+/// C14 lane-0 instrument (docs/probes/incremental-invalidation): seconds per phase,
+/// [0] element build + node registration (requestLayout), [1] strips + lowering checks,
+/// [2] computeRootLayout (measure + place), [3] prepaint + hover + focus, [4] paint,
+/// [5] end-of-frame sweeps, [6] whole render, [7] Component content getters.
+nonisolated(unsafe) public var ivPhase = [Double](repeating: 0, count: 8)
+func ivNow() -> Double { Double(DispatchTime.now().uptimeNanoseconds) / 1e9 }
