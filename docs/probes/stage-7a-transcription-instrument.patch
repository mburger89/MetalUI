+private func px(_ v: Float) -> MetalUICore.Dimension { .length(.pixels(Pixels(v))) }
+private func pl(_ v: Float) -> Length { .pixels(Pixels(v)) }
+private func pc(_ f: Float) -> MetalUICore.Dimension { .length(.percent(f)) }
+private func S(_ f: (inout Style) -> Void) -> Style { var s = Style(); f(&s); return s }
+private func sz(_ s: inout Style, _ w: Float?, _ h: Float?) {
+    s.size = Size(width: w != nil ? px(w!) : .auto, height: h != nil ? px(h!) : .auto)
+}
+private func edgesD(_ t: Float, _ r: Float, _ b: Float, _ l: Float) -> Edges<MetalUICore.Dimension> {
+    Edges(top: px(t), right: px(r), bottom: px(b), left: px(l))
+}
+private func edgesL(_ t: Float, _ r: Float, _ b: Float, _ l: Float) -> Edges<Length> {
+    Edges(top: pl(t), right: pl(r), bottom: pl(b), left: pl(l))
+}
+@MainActor private func L(_ id: String, _ f: (inout Style) -> Void) -> Box<EmptyGroup> { Box(style: S(f)).id(id) }
+@MainActor private func L(_ f: (inout Style) -> Void) -> Box<EmptyGroup> { Box(style: S(f)) }
+@MainActor private func C<G: ElementGroup>(_ id: String, _ f: (inout Style) -> Void,
+                                        @ElementBuilder _ c: () -> G) -> Box<G> {
+    Box(style: S(f), content: c()).id(id)
+}
+private func grow(_ s: inout Style, _ g: Float, _ sh: Float, _ b: MetalUICore.Dimension) { s.flexGrow = g; s.flexShrink = sh; s.flexBasis = b }
+
+private func name(_ id: GlobalElementID) -> String? {
+    if case .named(let n) = id.component { return n.name }
+    return nil
+}
+
+@MainActor
+private func dump<G: ElementGroup>(_ fixture: String, w: Float = 800, h: Float = 600,
+                                   @ElementBuilder _ make: @MainActor () -> G) {
+    for auth in [LayoutAuthority.legacy, .proposal] {
+        let f = LayoutDifferential.render(authority: auth, width: w, height: h, make)
+        var parts: [String] = []
+        for (id, b) in f.elementBounds {
+            guard let n = name(id) else { continue }
+            func g(_ p: Pixels) -> String { String(format: "%g", p.value) }
+            parts.append("\(n):\(g(b.origin.x)),\(g(b.origin.y)),\(g(b.size.width))x\(g(b.size.height))")
+        }
+        let unl = Set(f.unlowerableFields.map(\.description)).sorted().joined(separator: ",")
+        print("DUMP \(fixture) \(auth == .legacy ? "L" : "P") [\(unl)] | " + parts.sorted().joined(separator: " "))
+    }
+}
