# SGR edges: resets, 22 clears bold and dim, a bad 256-colour index ends the sequence, bare m resets.
size 20 1
input "\e[1;2;3;4;5;6;7;8;9m\e[22;23;24;25;27;28;29mA\e[38;5;1;1mB\e[39;49mC\e[21mD\e[4:0mE\e[48:5:99mF\e[38;5;999;1mG\e[mH"
text
|ABCDEFGH|
attr 0 0 plain
attr 0 1 bold fg=1
attr 0 2 bold
