#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Params
{
    float level0;
    packed_float3 padding;
};

struct main0_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct main0_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant type_Params& Params [[buffer(0)]], texture2d<float> source [[texture(0)]], sampler sourceSampler [[sampler(0)]])
{
    main0_out out = {};
    out.out_var_SV_Target0 = float4(source.sample(sourceSampler, in.in_var_TEXCOORD0, level(Params.level0)).xxx, 1.0);
    return out;
}

